{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    "docker:pinDigests"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "FROM alpine:(?<alpineVersion>\\d+\\.\\d+)[^\\n]*[\\s\\S]*?ARG IPERF3_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "apk",
      "depNameTemplate": "iperf3",
      "versioningTemplate": "apk",
      "registryUrlTemplate": "https://dl-cdn.alpinelinux.org/alpine?branch=v{{{alpineVersion}}}&components=main&arch=x86_64"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["alpine"],
      "pinDigests": true,
      "groupName": "alpine base image"
    },
    {
      "description": "Automatically merge patch version and digest update",
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true,
      "platformAutomerge": true
    }
  ]
}
